{
	"name": "mywayweb",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@posthog/react": "^1.7.0",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-slot": "^1.3.3",
		"@sentry/tanstackstart-react": "^10.67.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-start": "latest",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv-cli": "^11.0.0",
		"kysely": "^0.29.4",
		"kysely-turso": "^0.1.1",
		"lucide-react": "^0.577.0",
		"posthog-js": "^1.358.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-pattern": "^0.1.0",
		"tw-animate-css": "^1.3.6",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^17.3.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.118.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd",
			"better-sqlite3",
			"@sentry/cli"
		]
	}
}